# ---- Database (Neon PostgreSQL) ----
# NeonのダッシュボードからJDBC形式のURLを取得してください
# 例: jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-password

# ---- JWT ----
# 32バイト(256bit)以上のランダムな文字列を設定してください
# 生成例: openssl rand -base64 32
JWT_SECRET=your-random-secret-key-must-be-32bytes-or-more

# ---- Gemini LLM ----
GEMINI_API_KEY=your-gemini-api-key

# ---- CORS ----
# フロントエンドのURLをカンマ区切りで指定
CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-other-frontend.com

# ---- Server ----
# RenderがPORTを自動設定するため、通常は設定不要
# PORT=8080
